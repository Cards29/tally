# Copy to .env and fill in. .env is gitignored.

# Required. Local podman container; Neon uses its own URL with sslmode=require.
DATABASE_URL=postgres://tally:tally@localhost:5432/tally

# Where log entries live: postgres (default) or file.
# Users and sessions always live in Postgres.
STORAGE=postgres

# Required only when STORAGE=file.
# FILE_NAME=dates.log

# Optional. Defaults to 3000.
# PORT=3000
